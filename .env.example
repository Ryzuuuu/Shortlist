# Database
DATABASE_URL=postgresql://user:password@host/dbname

# Auth
BETTER_AUTH_SECRET=change-me-32-chars-minimum
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LLM Provider: anthropic | gemini | heuristic
LLM_PROVIDER=heuristic
ANTHROPIC_API_KEY=
# Optional: override the default model (claude-opus-5-5)
ANTHROPIC_MODEL=
GEMINI_API_KEY=
# Optional: override the default model (gemini-2.5-flash)
GEMINI_MODEL=

# File Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Seed (demo accounts only)
SEED_PASSWORD=

# Key for anonymising candidate IDs in the audit log after deletion (falls back to BETTER_AUTH_SECRET)
AUDIT_HASH_KEY=
